{
  "manifest_version": 3,
  "name": "Overmind Pipeline",
  "version": "1.0",
  "description": "Automates the @djthirstyboy track pipeline — ChatGPT + Suno",
  "permissions": ["tabs", "scripting", "storage", "alarms", "cookies"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://suno.com/*",
    "https://*.suno.ai/*",
    "https://*.suno.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.openai.com/*",
    "https://yrvxxnhwkmukhtwpcusw.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
