{
  "manifest_version": 3,
  "name": "Overmind Bridge",
  "version": "1.2",
  "description": "Bridges the Overmind dashboard with browser automation",
  "permissions": ["tabs", "scripting", "debugger"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://overmind-dashboard.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
